{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "Me-Gustan-Los-Pepinos-De-Leganes-Porque-Son-Grandes-Y-Hermosos-Como-Los-De-Carlos-Y-Su-Huerta!",
    "Issuer": "TiendaApi",
    "Audience": "TiendaApi",
    "ExpireMinutes": 60
  },
  "//Backends": "URLs base que sondea el gateway (/health y /swagger agregado). En local, localhost:{puerto}. En Docker (compose) se sobreescriben con Backends__{nombre}=http://identity:5101 etc.",
  "Backends": {
    "identity": "http://localhost:5101",
    "storage": "http://localhost:5102",
    "historical": "http://localhost:5103",
    "email": "http://localhost:5104",
    "catalog": "http://localhost:5105",
    "orders": "http://localhost:5106",
    "statistics": "http://localhost:5107",
    "backup": "http://localhost:5108",
    "graphql": "http://localhost:5109"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/{version}/auth/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/{version}/users/{**catch-all}"
        }
      },
      "categorias": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/{version}/categorias/{**catch-all}"
        }
      },
      "proveedores": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/{version}/proveedores/{**catch-all}"
        }
      },
      "productos": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/{version}/productos/{**catch-all}"
        }
      },
      "pedidos": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/{version}/pedidos/{**catch-all}"
        }
      },
      "estadisticas": {
        "ClusterId": "statistics",
        "Match": {
          "Path": "/api/{version}/estadisticas/{**catch-all}"
        }
      },
      "backup": {
        "ClusterId": "backup",
        "Match": {
          "Path": "/api/{version}/backup/{**catch-all}"
        }
      },
      "storage": {
        "ClusterId": "storage",
        "Match": {
          "Path": "/storage/{**catch-all}"
        }
      },
      "images": {
        "ClusterId": "storage",
        "Match": {
          "Path": "/images/{**catch-all}"
        }
      },
      "graphql": {
        "ClusterId": "graphql",
        "Match": {
          "Path": "/graphql"
        }
      },
      "graphql-rest": {
        "ClusterId": "graphql",
        "Match": {
          "Path": "/graphql/{**catch-all}"
        }
      },
      "hubs-productos": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/hubs/productos/{**catch-all}"
        }
      },
      "hubs-pedidos": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/hubs/pedidos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "storage": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "orders": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "statistics": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5107"
          }
        }
      },
      "backup": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5108"
          }
        }
      },
      "graphql": {
        "Destinations": {
          "destination0": {
            "Address": "http://localhost:5109"
          }
        }
      }
    }
  }
}
