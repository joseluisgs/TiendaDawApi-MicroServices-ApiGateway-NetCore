# ============================================================
# .env.example · plantilla de PRODUCCIÓN
# ============================================================
# Sirve para docker-compose.prod.yml (pila completa: gateway + 9 servicios + BDs).
#
#   cp .env.example .env        # y CAMBIA los valores marcados  CAMBIA
#   docker compose -f docker-compose.prod.yml up -d --build
#
# El compose falla al arrancar si falta JWT_KEY (es obligatorio): así no se
# escapa una clave por defecto a producción.
#
# ⚠️  DESARROLLO LOCAL: NO copies este fichero para trabajar en local.
#     En local los servicios leen appsettings.json (localhost/admin123) y las
#     BDs las levanta docker-compose.local.yml con sus defaults → usa
#     .env.development si quieres fijar algo.
#
# Notas 
#   • Auth__Mode NO existe (el proyecto es SOLO Identity: JWT + OAuth 2.0).
#   • La topología (URLs entre servicios, clusters YARP) NO va aquí: vive en
#     appsettings.Production.json de cada servicio.
#   • JWT_KEY debe ser IGUAL para gateway, identity y todos los servicios
#     validadores: cambies lo que cambies, reinicia TODOS los contenedores.

# ============================== Infraestructura =============================
POSTGRES_DB=tienda
POSTGRES_USER=admin
POSTGRES_PASSWORD=CAMBIA_password_de_postgres
POSTGRES_PORT=5432

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CAMBIA_password_de_mongo
MONGO_DB=tienda
MONGO_PORT=27017

REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# Cassandra (serie histórica de precios y feed). La JVM necesita techo de heap.
CASSANDRA_PORT=9042
CASSANDRA_MAX_HEAP=1G
CASSANDRA_HEAP_NEWSIZE=256M

# ================================ Gateway ===================================
# Único puerto público de toda la plataforma.
API_PORT=5000
# Host del router Traefik (labels del gateway); localhost si no usas Traefik.
DOMAIN=localhost

# ================================ Compilación ===============================
BUILD_CONFIGURATION=Release

# =================================== JWT ====================================
# Obligatoria: mínimo 32 caracteres (HS256). CAMBIA la frase de ejemplo.
JWT_KEY=CAMBIA_esta_clave_a_un_valor_de_32_caracteres_o_mas
JWT_ISSUER=TiendaApi
JWT_AUDIENCE=TiendaApi
JWT_EXPIRE_MINUTES=60

# ============================ Login externo (OAuth) ==========================
# identity es el único servicio con puertas externas. Para activarlas: Enabled=true
# y rellena ClientId/Secret de cada proveedor en su consola de desarrolladores.
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

AUTH_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ================================== SMTP =====================================
# Vacío → email-service degrada (no envía) sin bloquear el arranque.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tienda.com
SMTP_FROM_NAME=TiendaApi Notifications
SMTP_ADMIN_EMAIL=admin@tienda.com

# ================================= Storage ==================================
STORAGE_MAX_FILE_SIZE=5242880

# =========================== Límites de recursos ============================
# Aplican a los 10 contenedores .NET (gateway + servicios).
SERVICE_CPUS=1
SERVICE_MEMORY=512M
SERVICE_CPUS_RESERVED=0.25
SERVICE_MEMORY_RESERVED=128M

POSTGRES_CPUS=1
POSTGRES_MEMORY=512M
POSTGRES_CPUS_RESERVED=0.5
POSTGRES_MEMORY_RESERVED=256M

MONGO_CPUS=1
MONGO_MEMORY=512M
MONGO_CPUS_RESERVED=0.5
MONGO_MEMORY_RESERVED=256M

REDIS_CPUS=0.5
REDIS_MEMORY=256M
REDIS_CPUS_RESERVED=0.25
REDIS_MEMORY_RESERVED=128M

CASSANDRA_CPUS=1
CASSANDRA_MEMORY=2G
CASSANDRA_CPUS_RESERVED=0.5
CASSANDRA_MEMORY_RESERVED=1G
