# ============================================================
# .env.development · plantilla de DESARROLLO local
# ============================================================
# Alimenta SOLO docker-compose.local.yml (las 4 BDs + Adminer + Mongo Express).
#
#   cp .env.development .env    # opcional: sin .env, los defaults ya son estos
#   .\Reset-Database.ps1        # levanta/limpia las BDs para los E2E
#
# En desarrollo los servicios NO leen este fichero:
#   • se arrancan con `dotnet run` (reiniciar-api.ps1) y leen appsettings.json
#     (localhost, admin123, Auth solo Identity);
#   • la caché es en MEMORIA (CacheConfig usa MemoryCache en Development),
#     por eso este compose NO incluye Redis: es opcional en local.
#
# ⚠️  En un proyecto real las credenciales no se versionan; aquí los valores son
#     los defaults educativos de las imágenes (admin123) para que "clone y
#     ejecuta" funcione. Para PRODUCCIÓN usa .env.example.
#
# Notas 
#   • Auth__Mode NO existe: el proyecto es SOLO Identity (JWT + OAuth 2.0).
#   • Las BDs solo publican en 127.0.0.1: nada de la red local entra sin querer.

POSTGRES_DB=tienda
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5432

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DB=tienda
MONGO_PORT=27017
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# Cassandra: la JVM necesita techo de heap (misma razón que en producción).
CASSANDRA_PORT=9042
CASSANDRA_MAX_HEAP=1G
CASSANDRA_HEAP_NEWSIZE=256M

ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8081
