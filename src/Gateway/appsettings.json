{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "root": {
        "ClusterId": "monolito",
        "Match": { "Path": "/" }
      },
      "health": {
        "ClusterId": "monolito",
        "Match": { "Path": "/health" }
      },
      "health-sub": {
        "ClusterId": "monolito",
        "Match": { "Path": "/health/{**catch-all}" }
      },
      "version": {
        "ClusterId": "monolito",
        "Match": { "Path": "/version" }
      },
      "swagger": {
        "ClusterId": "monolito",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "categorias": {
        "ClusterId": "monolito",
        "Match": { "Path": "/api/categorias/{**catch-all}" }
      },
      "proveedores": {
        "ClusterId": "monolito",
        "Match": { "Path": "/api/proveedores/{**catch-all}" }
      },
      "productos": {
        "ClusterId": "monolito",
        "Match": { "Path": "/api/productos/{**catch-all}" }
      },
      "pedidos": {
        "ClusterId": "monolito",
        "Match": { "Path": "/api/pedidos/{**catch-all}" }
      },
      "estadisticas": {
        "ClusterId": "monolito",
        "Match": { "Path": "/api/estadisticas/{**catch-all}" }
      },
      "backup": {
        "ClusterId": "monolito",
        "Match": { "Path": "/api/backup/{**catch-all}" }
      },
      "storage": {
        "ClusterId": "monolito",
        "Match": { "Path": "/storage/{**catch-all}" }
      },
      "images": {
        "ClusterId": "monolito",
        "Match": { "Path": "/images/{**catch-all}" }
      },
      "graphql": {
        "ClusterId": "monolito",
        "Match": { "Path": "/graphql" }
      },
      "graphql-rest": {
        "ClusterId": "monolito",
        "Match": { "Path": "/graphql/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "monolito",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },
      "ws": {
        "ClusterId": "monolito",
        "Match": { "Path": "/ws/{**catch-all}" }
      }
    },
    "Clusters": {
      "monolito": {
        "Destinations": {
          "destination0": { "Address": "http://localhost:5031" }
        }
      },
      "identity": {
        "Destinations": {
          "destination0": { "Address": "http://localhost:5101" }
        }
      }
    }
  }
}
